@model IEnumerable<Shopping.Data.Entities.Address>
@inject Shopping.Helpers.ITranslator Localizer
@{
    ViewData["Title"] = "Mis Direcciones";
}

<h1 class="mb-4">@Localizer["AddressesTitle"]</h1>

<p><a asp-action="Create" class="btn btn-primary">@Localizer["AddAddressButton"]</a></p>

@if (!Model.Any())
{
    <p class="text-muted">@Localizer["NoAddressesNote"]</p>
}
else
{
    <div class="row g-3">
        @foreach (var address in Model)
        {
            <div class="col-md-4">
                <div class="panel panel-default p-3">
                    <h6>@address.Recipient @(address.IsDefault ? Html.Raw($"<span class='badge bg-success'>{Localizer["DefaultBadge"]}</span>") : Html.Raw(""))</h6>
                    <p>@address.FullAddress</p>
                    <p>@address.PhoneNumber</p>
                    @if (!address.IsDefault)
                    {
                        <a asp-action="SetDefault" asp-route-id="@address.Id" class="btn btn-sm btn-outline-primary">@Localizer["SetDefaultButton"]</a>
                    }
                    <a asp-action="Delete" asp-route-id="@address.Id" class="btn btn-sm btn-outline-danger">@Localizer["DeleteAction"]</a>
                </div>
            </div>
        }
    </div>
}
