@model IEnumerable<Shopping.Data.Entities.Address>
@{
    ViewData["Title"] = "Mis Direcciones";
}

<h1 class="mb-4">Mis Direcciones</h1>

<p><a asp-action="Create" class="btn btn-primary">Agregar Dirección</a></p>

@if (!Model.Any())
{
    <p class="text-muted">Aún no tienes direcciones guardadas. Se usará la dirección de tu perfil al comprar.</p>
}
else
{
    <div class="row g-3">
        @foreach (var address in Model)
        {
            <div class="col-md-4">
                <div class="panel panel-default p-3">
                    <h6>@address.Recipient @(address.IsDefault ? "<span class='badge bg-success'>Predeterminada</span>" : "")</h6>
                    <p>@address.FullAddress</p>
                    <p>@address.PhoneNumber</p>
                    @if (!address.IsDefault)
                    {
                        <a asp-action="SetDefault" asp-route-id="@address.Id" class="btn btn-sm btn-outline-primary">Predeterminar</a>
                    }
                    <a asp-action="Delete" asp-route-id="@address.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </div>
            </div>
        }
    </div>
}
