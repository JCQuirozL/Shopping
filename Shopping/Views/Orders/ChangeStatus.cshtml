@model Shopping.Models.ChangeOrderStatusViewModel
@inject Shopping.Helpers.ITranslator Localizer
@{
    ViewData["Title"] = "Actualizar Estado";
}

<h1 class="mb-4">Actualizar Estado - Pedido #@Model.SaleId</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="ChangeStatus" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SaleId" />
            <div class="form-group mb-2">
                <label asp-for="OrderStatus" class="control-label"></label>
                <select asp-for="OrderStatus" class="form-select">
                    @foreach (Shopping.Enums.OrderStatus status in Enum.GetValues(typeof(Shopping.Enums.OrderStatus)))
                    {
                        <option value="@status">@Localizer[$"Status_{status}"]</option>
                    }
                </select>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Carrier" class="control-label"></label>
                <input asp-for="Carrier" class="form-control" placeholder="Ej. DHL, Estafeta, FedEx..." />
            </div>
            <div class="form-group mb-2">
                <label asp-for="TrackingNumber" class="control-label"></label>
                <input asp-for="TrackingNumber" class="form-control" />
            </div>
            <div class="form-group mb-2">
                <label asp-for="EstimatedDeliveryDate" class="control-label"></label>
                <input asp-for="EstimatedDeliveryDate" class="form-control" type="date" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            </div>
            <input type="submit" value="Guardar" class="btn btn-primary" />
            <a asp-action="Details" asp-route-id="@Model.SaleId" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
