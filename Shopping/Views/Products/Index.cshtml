@model IEnumerable<Shopping.Data.Entities.Product>

@{
    ViewData["Title"] = "Index";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.10.19/css/jquery.dataTables.min.css" />

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Productos</h3>
                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Nuevo producto</a>
            </div>
            <div class="panel-body">
                <table class="table table-hover table-responsive" id="MyTable">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>@Html.DisplayNameFor(model => model.Price)</th>
                            <th>@Html.DisplayNameFor(model => model.Stock)</th>
                            <th>@Html.DisplayNameFor(model => model.CategoriesNumber)</th>
                            <th>@Html.DisplayNameFor(model => model.ImagesNumber)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            bool outOfStock = item.Stock <= 0;
                            bool lowStock = !outOfStock && item.Stock <= 10;
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@item.ImageFullPath" class="table-thumb" alt="@item.Name" onerror="this.onerror=null;this.src='@item.ImageFallbackPath'" />
                                        <div>
                                            <div class="fw-semibold text-navy">@item.Name</div>
                                            <div class="text-muted small text-truncate" style="max-width: 340px;">@item.Description</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Price)</td>
                                <td>
                                    @if (outOfStock)
                                    {
                                        <span class="status-badge status-badge-danger"><i class="fa-solid fa-circle-exclamation"></i> Agotado</span>
                                    }
                                    else if (lowStock)
                                    {
                                        <span class="status-badge status-badge-warning"><i class="fa-solid fa-triangle-exclamation"></i> @item.Stock.ToString("N0") - Bajo</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-badge-success"><i class="fa-solid fa-circle-check"></i> @item.Stock.ToString("N0") disponibles</span>
                                    }
                                </td>
                                <td><span class="count-pill"><i class="fa-solid fa-tags"></i> @item.CategoriesNumber</span></td>
                                <td><span class="count-pill"><i class="fa-solid fa-images"></i> @item.ImagesNumber</span></td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="icon-btn" title="Editar"><i class="fa-solid fa-pen-to-square"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="icon-btn" title="Detalles"><i class="fa-solid fa-circle-info"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="icon-btn icon-btn-danger" title="Eliminar"><i class="fa-solid fa-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="//cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function() {
            $('#MyTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/9dcbecd42ad/i18n/Spanish.json"
                },
                "aLengthMenu": [
                    [25, 50, 100, 200, -1],
                    [25, 50, 100, 200, "Todos"]
                ]
            });
        });
    </script>
}
