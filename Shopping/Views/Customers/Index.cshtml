@model IEnumerable<Shopping.Data.Entities.User>
@{
    ViewData["Title"] = "Clientes";
}

<h1 class="mb-4">Gestión de Clientes</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Buscar por nombre, email o documento..." />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr><th>Nombre</th><th>Documento</th><th>Email</th><th>Teléfono</th><th>Ciudad</th><th>Tipo</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Document</td>
                <td>@user.Email</td>
                <td>@user.PhoneNumber</td>
                <td>@user.City?.Name</td>
                <td>@user.UserType</td>
                <td><a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info"><i class="fa-solid fa-circle-info"></i> Ver</a></td>
            </tr>
        }
    </tbody>
</table>
