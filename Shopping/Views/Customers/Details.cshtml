@model Shopping.Models.CustomerDetailsViewModel
@inject Shopping.Helpers.ITranslator Localizer
@{
    ViewData["Title"] = "Detalle de Cliente";
}

<h1 class="mb-4">@Model.User.FullName</h1>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="panel panel-default p-3">
            <h5>Datos de contacto</h5>
            <p><strong>Documento:</strong> @Model.User.Document</p>
            <p><strong>Email:</strong> @Model.User.Email</p>
            <p><strong>Teléfono:</strong> @Model.User.PhoneNumber</p>
            <p><strong>Dirección de perfil:</strong> @Model.User.Address, @Model.User.City?.Name</p>
            <p><strong>Total gastado:</strong> @Model.TotalSpent.ToString("C2")</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel panel-default p-3">
            <h5>Direcciones guardadas</h5>
            @if (!Model.Addresses.Any())
            {
                <p class="text-muted">Sin direcciones guardadas.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var address in Model.Addresses)
                    {
                        <li class="list-group-item">
                            <strong>@address.Recipient</strong> @(address.IsDefault ? "(Predeterminada)" : "")<br />
                            @address.FullAddress - @address.PhoneNumber
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

<div class="panel panel-default p-3">
    <h5>Historial de pedidos</h5>
    <table class="table table-striped table-hover">
        <thead><tr><th>Id</th><th>Fecha</th><th>Estado</th><th>Líneas</th><th>Valor</th><th></th></tr></thead>
        <tbody>
            @foreach (var sale in Model.Orders)
            {
                <tr>
                    <td>#@sale.Id</td>
                    <td>@sale.Date.ToString("dd/MM/yyyy")</td>
                    <td><span class="badge bg-secondary">@Localizer[$"Status_{sale.OrderStatus}"]</span></td>
                    <td>@sale.Lines</td>
                    <td>@sale.Value.ToString("C2")</td>
                    <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@sale.Id" class="btn btn-sm btn-outline-info">Ver</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-outline-secondary mt-3">Volver</a>
