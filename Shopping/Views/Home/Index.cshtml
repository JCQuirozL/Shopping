@model Shopping.Models.HomeViewModel
@inject Shopping.Helpers.ITranslator Localizer

@{
    ViewData["Title"] = "Index";
}

<div class="shop-toolbar">
    <div class="category-pills">
        <a asp-action="Index" asp-route-search="@Model.Search"
           class="pill @(Model.CategoryId == null ? "pill-active" : "")">@Localizer["CategoryAll"]</a>
        @foreach (var category in Model.Categories)
        {
            <a asp-action="Index" asp-route-search="@Model.Search" asp-route-categoryId="@category.Id"
               class="pill @(Model.CategoryId == category.Id ? "pill-active" : "")">@category.GetLocalizedName()</a>
        }
    </div>

    @if (Model.Quantity > 0)
    {
        <a asp-action="ShowCart" class="btn btn-primary cart-pill">
            <i class="fa-solid fa-cart-shopping"></i> @Localizer["CartLabel"] (@Model.Quantity)
        </a>
    }
</div>

@if (!Model.Products.Any())
{
    <div class="empty-state">
        <i class="fa-solid fa-box-open icon-lg text-accent"></i>
        <h4>@Localizer["NoProductsFound"]</h4>
        <p class="text-muted">@Localizer["TryAnotherSearch"]</p>
        <a asp-action="Index" class="btn btn-outline-primary">@Localizer["ViewAllProducts"]</a>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var product in Model.Products)
        {
            bool hasDiscount = Shopping.Helpers.DiscountHelper.HasDiscount(product.Id);
            <div class="product-card">
                <a asp-action="Details" asp-route-id="@product.Id" class="product-card_media zoom">
                    <img src="@product.ImageFullPath" alt="@product.Name" onerror="this.onerror=null;this.src='@product.ImageFallbackPath'" />
                </a>
                @if (hasDiscount)
                {
                    <span class="discount-badge">-@Shopping.Helpers.DiscountHelper.GetDiscountPercentage(product.Id)%</span>
                }
                <div class="product-card_body">
                    <a asp-action="Details" asp-route-id="@product.Id" class="product-card_title">@product.GetLocalizedName()</a>
                    <p class="product-card_description">@product.GetLocalizedDescription()</p>
                    @if (hasDiscount)
                    {
                        <div class="product-card_price-row">
                            <span class="product-card_price-old">@await Component.InvokeAsync("Currency", new { amount = product.Price })</span>
                            <div class="product-card_price product-card_price-discount">@await Component.InvokeAsync("Currency", new { amount = Shopping.Helpers.DiscountHelper.GetDiscountedPrice(product) })</div>
                        </div>
                    }
                    else
                    {
                        <div class="product-card_price">@await Component.InvokeAsync("Currency", new { amount = product.Price })</div>
                    }
                </div>
                <div class="product-card_foot">
                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">@Localizer["DetailsButton"]</a>
                    <a asp-action="Add" asp-route-id="@product.Id" class="btn btn-primary btn-sm"><i class="fa-solid fa-cart-plus"></i> @Localizer["AddButton"]</a>
                </div>
            </div>
        }
    </div>
}
