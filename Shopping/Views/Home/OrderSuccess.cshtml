@inject Shopping.Helpers.ITranslator Localizer
@{

    ViewData["Title"] = "Order Success";
}
<div class="empty-state">
    <i class="fa-solid fa-circle-check icon-lg text-accent"></i>
    <h2>@Localizer["ThankYouTitle"]</h2>
    <h5 class="text-muted">@Localizer["OrderRegisteredNote"]</h5>

    @if (ViewBag.PaymentMethod != null)
    {
        <div class="cart-summary mx-auto mt-4" style="max-width: 360px; text-align: left;">
            <div class="cart-summary_row">
                <span>@Localizer["PaymentMethodLabel"]</span>
                <strong>
                    @(ViewBag.PaymentMethod switch
                    {
                        "CreditCard" => Localizer["CreditCardOption"],
                        "DebitCard" => Localizer["DebitCardOption"],
                        "PayPal" => "PayPal",
                        "Cash" => Localizer["CashOnDeliveryOption"],
                        _ => ViewBag.PaymentMethod
                    })
                </strong>
            </div>
            <div class="cart-summary_row cart-summary_total">
                <span>@Localizer["TotalPaidLabel"]</span>
                <strong>@ViewBag.PaymentTotal</strong>
            </div>
        </div>
    }

    <a asp-action="Index" class="btn btn-primary mt-4">@Localizer["ContinueShoppingButton"]</a>
</div>