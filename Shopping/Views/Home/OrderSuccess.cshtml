@{

    ViewData["Title"] = "Order Success";
}
<div class="empty-state">
    <i class="fa-solid fa-circle-check icon-lg text-accent"></i>
    <h2>¡Gracias por tu compra!</h2>
    <h5 class="text-muted">Tu pedido fue registrado en nuestro sistema, pronto uno de nuestros asesores se comunicará contigo.</h5>

    @if (ViewBag.PaymentMethod != null)
    {
        <div class="cart-summary mx-auto mt-4" style="max-width: 360px; text-align: left;">
            <div class="cart-summary_row">
                <span>Método de pago</span>
                <strong>
                    @(ViewBag.PaymentMethod switch
                    {
                        "CreditCard" => "Tarjeta de Crédito",
                        "DebitCard" => "Tarjeta de Débito",
                        "PayPal" => "PayPal",
                        "Cash" => "Contra Entrega",
                        _ => ViewBag.PaymentMethod
                    })
                </strong>
            </div>
            <div class="cart-summary_row cart-summary_total">
                <span>Total pagado</span>
                <strong>@ViewBag.PaymentTotal</strong>
            </div>
        </div>
    }

    <a asp-action="Index" class="btn btn-primary mt-4">Seguir Comprando</a>
</div>