@model Shopping.Models.ShowCartViewModel
@{
    ViewData["Title"] = "Cart";
}

<nav class="breadcrumb-bar">
    <a asp-action="Index">Inicio</a> <span>/</span> <span class="text-navy">Carro de Compras</span>
</nav>

<h1 class="mb-4">Carro de Compras</h1>

@if (Model.TemporalSales == null || !Model.TemporalSales.Any())
{
    <div class="empty-state">
        <i class="fa-solid fa-cart-shopping icon-lg text-accent"></i>
        <h4>Tu carro está vacío</h4>
        <p class="text-muted">Agrega productos para continuar con tu compra.</p>
        <a asp-action="Index" class="btn btn-outline-primary">Ver productos</a>
    </div>
}
else
{
    <div class="cart-layout">
        <div class="cart-items">
            @foreach (var item in Model.TemporalSales)
            {
                <div class="cart-item">
                    <a asp-action="Details" asp-route-id="@item.Product.Id" class="cart-item_media zoom">
                        <img src="@item.Product.ImageFullPath" alt="@item.Product.Name" />
                    </a>
                    <div class="cart-item_body">
                        <a asp-action="Details" asp-route-id="@item.Product.Id" class="cart-item_title">@item.Product.Name</a>
                        @if (!string.IsNullOrWhiteSpace(item.Remarks))
                        {
                            <p class="cart-item_remarks">@item.Remarks</p>
                        }
                        <div class="cart-item_price">@await Component.InvokeAsync("Currency", new { amount = item.Product.Price })</div>
                    </div>
                    <div class="cart-item_qty">
                        <a asp-action="DecreaseQuantity" asp-route-id="@item.Id" class="qty-btn">−</a>
                        <span>@item.Quantity.ToString("N0")</span>
                        <a asp-action="IncreaseQuantity" asp-route-id="@item.Id" class="qty-btn">+</a>
                    </div>
                    <div class="cart-item_total">@await Component.InvokeAsync("Currency", new { amount = item.Value })</div>
                    <div class="cart-item_actions">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="icon-btn" title="Editar"><i class="fa-solid fa-pen-to-square"></i></a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="icon-btn icon-btn-danger" title="Eliminar"><i class="fa-solid fa-trash"></i></a>
                    </div>
                </div>
            }
        </div>

        <div class="cart-summary">
            <h5>Resumen del pedido</h5>
            <div class="cart-summary_row">
                <span>@Html.DisplayNameFor(model => model.Quantity)</span>
                <strong>@Html.DisplayFor(model => model.Quantity)</strong>
            </div>
            <div class="cart-summary_row cart-summary_total">
                <span>@Html.DisplayNameFor(model => model.Value)</span>
                <strong>@await Component.InvokeAsync("Currency", new { amount = Model.Value })</strong>
            </div>
            <form asp-action="ShowCart">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group mt-2">
                    <label asp-for="ShippingRecipient" class="control-label"></label>
                    <input asp-for="ShippingRecipient" class="form-control" />
                    <span asp-validation-for="ShippingRecipient" class="text-danger"></span>
                </div>
                <div class="form-group mt-2">
                    <label asp-for="ShippingPhone" class="control-label"></label>
                    <input asp-for="ShippingPhone" class="form-control" />
                    <span asp-validation-for="ShippingPhone" class="text-danger"></span>
                </div>
                @if (Model.SavedAddresses.Any())
                {
                    <div class="form-group mt-2">
                        <label>Dirección guardada</label>
                        <select class="form-select" onchange="document.getElementById('ShippingAddress').value = this.value">
                            <option value="">-- Escribir manualmente --</option>
                            @foreach (var address in Model.SavedAddresses)
                            {
                                <option value="@address.FullAddress" selected="@(address.FullAddress == Model.ShippingAddress)">@address.Recipient - @address.FullAddress</option>
                            }
                        </select>
                    </div>
                }
                <div class="form-group mt-2">
                    <label asp-for="ShippingAddress" class="control-label"></label>
                    <textarea asp-for="ShippingAddress" class="form-control" rows="2" id="ShippingAddress"></textarea>
                    <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                </div>
                <div class="form-group mt-3 d-grid gap-2">
                    <input type="submit" value="Ir a Pagar" class="btn btn-primary btn-lg" />
                    <a asp-action="Index" class="btn btn-outline-primary">Seguir Comprando</a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
