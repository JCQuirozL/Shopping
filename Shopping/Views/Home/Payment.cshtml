@model Shopping.Models.PaymentViewModel
@inject Shopping.Helpers.ITranslator Localizer
@{
    ViewData["Title"] = "Payment";
}

<nav class="breadcrumb-bar">
    <a asp-action="Index">@Localizer["NavHome"]</a> <span>/</span> <a asp-action="ShowCart">@Localizer["CartTitle"]</a> <span>/</span> <span class="text-navy">@Localizer["PaymentBreadcrumb"]</span>
</nav>

<h1 class="mb-4">@Localizer["ChoosePaymentTitle"]</h1>

<div class="payment-layout">
    <form asp-action="Payment" method="post" id="paymentForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group mb-2">
            <label asp-for="ShippingRecipient" class="control-label"></label>
            <input asp-for="ShippingRecipient" class="form-control" />
            <span asp-validation-for="ShippingRecipient" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="ShippingPhone" class="control-label"></label>
            <input asp-for="ShippingPhone" class="form-control" />
            <span asp-validation-for="ShippingPhone" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="ShippingAddress" class="control-label"></label>
            <textarea asp-for="ShippingAddress" class="form-control" rows="2"></textarea>
            <span asp-validation-for="ShippingAddress" class="text-danger"></span>
        </div>

        <div class="payment-methods">
            <label class="payment-method">
                <input type="radio" name="PaymentMethod" value="CreditCard" checked />
                <span><i class="fa-solid fa-credit-card"></i> @Localizer["CreditCardOption"]</span>
            </label>
            <label class="payment-method">
                <input type="radio" name="PaymentMethod" value="DebitCard" />
                <span><i class="fa-solid fa-credit-card"></i> @Localizer["DebitCardOption"]</span>
            </label>
            <label class="payment-method">
                <input type="radio" name="PaymentMethod" value="PayPal" />
                <span><i class="fa-brands fa-paypal"></i> PayPal</span>
            </label>
            <label class="payment-method">
                <input type="radio" name="PaymentMethod" value="Cash" />
                <span><i class="fa-solid fa-money-bill-wave"></i> @Localizer["CashOnDeliveryOption"]</span>
            </label>
        </div>

        <div id="cardFields" class="card-fields">
            <div class="form-group">
                <label asp-for="CardHolder" class="control-label"></label>
                <input asp-for="CardHolder" class="form-control" placeholder="@Localizer["CardHolderPlaceholder"]" />
                <span asp-validation-for="CardHolder" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CardNumber" class="control-label"></label>
                <input asp-for="CardNumber" class="form-control" placeholder="0000 0000 0000 0000" maxlength="19" />
                <span asp-validation-for="CardNumber" class="text-danger"></span>
                <small class="form-text text-muted">@Localizer["CardSimulationNote"]</small>
            </div>
            <div class="row">
                <div class="col-6">
                    <div class="form-group">
                        <label asp-for="ExpirationDate" class="control-label"></label>
                        <input asp-for="ExpirationDate" class="form-control" placeholder="MM/AA" />
                        <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label asp-for="Cvv" class="control-label"></label>
                        <input asp-for="Cvv" class="form-control" placeholder="123" maxlength="4" />
                        <span asp-validation-for="Cvv" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div id="paypalFields" class="payment-note d-none">
            <i class="fa-brands fa-paypal text-accent icon-lg"></i>
            <p>@Localizer["PaypalRedirectNote"]</p>
        </div>

        <div id="cashFields" class="payment-note d-none">
            <i class="fa-solid fa-truck text-accent icon-lg"></i>
            <p>@Localizer["CashDeliveryNote"]</p>
        </div>

        <input type="submit" value="@Localizer["PayNowButton"]" class="btn btn-primary btn-lg w-100 mt-3" />
    </form>

    <div class="cart-summary">
        <h5>@Localizer["PaymentSummary"]</h5>
        <div class="cart-summary_row">
            <span>@Localizer["ItemsLabel"]</span>
            <strong>@Model.Items.ToString("N0")</strong>
        </div>
        <div class="cart-summary_row cart-summary_total">
            <span>@Localizer["TotalToPay"]</span>
            <strong>@await Component.InvokeAsync("Currency", new { amount = Model.Total })</strong>
        </div>
        <p class="payment-security"><i class="fa-solid fa-lock"></i> @Localizer["SimulatedPaymentNote"]</p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var cardFields = document.getElementById("cardFields");
            var paypalFields = document.getElementById("paypalFields");
            var cashFields = document.getElementById("cashFields");
            var radios = document.querySelectorAll("input[name='PaymentMethod']");

            function toggle() {
                var value = document.querySelector("input[name='PaymentMethod']:checked").value;
                cardFields.classList.toggle("d-none", value !== "CreditCard" && value !== "DebitCard");
                paypalFields.classList.toggle("d-none", value !== "PayPal");
                cashFields.classList.toggle("d-none", value !== "Cash");
            }

            radios.forEach(function (radio) {
                radio.addEventListener("change", toggle);
            });

            toggle();
        })();
    </script>
}
