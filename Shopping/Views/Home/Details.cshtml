@model Shopping.Models.AddProductToCartViewModel
@inject Shopping.Helpers.ITranslator Localizer
@{
    ViewData["Title"] = "Details";
}

<nav class="breadcrumb-bar">
    <a asp-action="Index">@Localizer["NavHome"]</a> <span>/</span> <span>@Model?.Categories</span> <span>/</span> <span class="text-navy">@Model?.Name</span>
</nav>

<div class="product-detail">
    <div class="product-detail_gallery">
        <div id="ImagesCarousel" class="carousel slide" data-ride="carousel">
            <div class="carousel-inner">
                @if (!Model.HasImages)
                {
                    <div class="carousel-item active">
                        <img class="d-block w-100" src="@Model.ImageFullPath" alt="@Model.Name" onerror="this.onerror=null;this.src='@Model.ImageFallbackPath'">
                    </div>
                }
                else
                {
                    var first = true;
                    @foreach (var item in @Model?.ProductImages)
                    {

                        <div class="carousel-item @(first?Html.Raw("active"):Html.Raw(""))">
                            <img class="d-block w-100" src="@item.ImageFullPath" alt="@item.Id">
                        </div>
                        first = false;
                    }
                }
            </div>
            <a id="ImagesCarouselPrev" class="carousel-control-prev" href="#ImagesCarousel" role="button"
               data-slide="prev">
               <i class="fa-solid fa-arrow-left fa-beat text-accent icon-lg"></i>
               @* <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only btn btn-secondary">Anterior</span>*@
            </a>
            <a id="ImagesCarouselNext" class="carousel-control-next" href="#ImagesCarousel" role="button"
               data-slide="next">
               <i class="fa-solid fa-arrow-right fa-beat text-accent icon-lg"></i>
                @*<span class="carousel-control-next-icon" aria-hidden="true"></span>*@
                @*<span class="sr-only btn-primary btn">Siguiente</span>*@
            </a>
        </div>
    </div>

    <div class="product-detail_buybox">
        <span class="buybox-category">@Model?.Categories</span>
        <h1 class="buybox-title">@Model?.Name</h1>
        @{
            bool hasDiscount = Shopping.Helpers.DiscountHelper.HasDiscount(Model.Id);
        }
        @if (hasDiscount)
        {
            <div class="buybox-price-row">
                <span class="buybox-price-old">@await Component.InvokeAsync("Currency", new { amount = Model.Price })</span>
                <span class="discount-badge-inline">-@Shopping.Helpers.DiscountHelper.GetDiscountPercentage(Model.Id)%</span>
            </div>
            <div class="buybox-price">@await Component.InvokeAsync("Currency", new { amount = Shopping.Helpers.DiscountHelper.GetDiscountedPrice(new Shopping.Data.Entities.Product { Id = Model.Id, Price = Model.Price }) })</div>
        }
        else
        {
            <div class="buybox-price">@await Component.InvokeAsync("Currency", new { amount = Model.Price })</div>
        }
        <p class="buybox-description">@Model?.Description</p>
        <div class="buybox-stock">
            <i class="fa-solid fa-boxes-stacked text-accent"></i>
            @Model?.Stock.ToString("N0") @Localizer["AvailableUnits"]
        </div>

        <form asp-action="Details" class="buybox-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Remarks" class="control-label"></label>
                <input asp-for="Remarks" class="form-control" placeholder="@Localizer["OptionalPlaceholder"]" />
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>
            <div class="form-group mt-3 buybox-actions">
                <input type="submit" value="@Localizer["AddToCartButton"]" class="btn btn-secondary btn-lg" />
                <a asp-action="BuyNow" asp-route-id="@Model?.Id" class="btn btn-primary btn-lg">@Localizer["BuyNowButton"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script type="text/javascript">
        $(document).ready(function() {
            $("#ImagesCarousel").carousel();
            $("#ImagesCarouselPrev").click(function() {
                $("#ImagesCarousel").carousel("prev");
            });
            $("#ImagesCarouselNext").click(function() {
                $("#ImagesCarousel").carousel("next");
            });
        });
    </script>
}