@model List<Shopping.Data.Entities.Category>
@inject Shopping.Helpers.ITranslator Localizer

<li class="nav-item dropdown mega-menu-trigger">
    <a class="nav-link text-white dropdown-toggle" href="#" id="categoriesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fa-solid fa-bars"></i> @Localizer["NavCategoriesMenu"]
    </a>
    <ul class="dropdown-menu mega-menu" aria-labelledby="categoriesDropdown">
        @foreach (var category in Model)
        {
            <li>
                <a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-categoryId="@category.Id">
                    <i class="fa-solid fa-tag text-accent"></i> @category.Name
                </a>
            </li>
        }
    </ul>
</li>
