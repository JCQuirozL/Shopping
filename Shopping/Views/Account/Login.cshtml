@model Shopping.Models.LoginViewModel
@inject Shopping.Helpers.ITranslator Localizer
@{
    ViewData["Title"] = "Login";
}

<div class="auth-layout">
    <div class="auth-card">
        <div class="auth-card_brand">
            <i class="fa-solid fa-bag-shopping icon-lg"></i>
            <span>Shopping</span>
        </div>
        <h1 class="auth-card_title">@Localizer["Login"]</h1>
        <p class="auth-card_subtitle">Bienvenido de nuevo, ingresa tus datos para continuar.</p>

        <div class="social-login">
            <form asp-controller="Account" asp-action="ExternalLogin" method="post">
                <input type="hidden" name="provider" value="Google" />
                <button type="submit" class="btn social-btn social-btn-google">
                    <i class="fa-brands fa-google"></i> @Localizer["LoginWithGoogle"]
                </button>
            </form>
            <form asp-controller="Account" asp-action="ExternalLogin" method="post">
                <input type="hidden" name="provider" value="Facebook" />
                <button type="submit" class="btn social-btn social-btn-facebook">
                    <i class="fa-brands fa-facebook"></i> @Localizer["LoginWithFacebook"]
                </button>
            </form>
        </div>

        <div class="auth-divider"><span>@Localizer["OrDivider"]</span></div>

        <form asp-action="Login">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Username" class="control-label"></label>
                <input asp-for="Username" class="form-control" placeholder="tu@email.com" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group mt-2 mb-3 d-flex justify-content-between align-items-center">
                <div class="form-check">
                    <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
                <a asp-action="RecoverPassword" class="auth-link">¿Olvidaste tu contraseña?</a>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100"><i class="fa-solid fa-right-to-bracket"></i> @Localizer["Login"]</button>
        </form>

        <div class="auth-card_footer">
            ¿No tienes cuenta? <a asp-action="Register">Regístrate gratis</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
