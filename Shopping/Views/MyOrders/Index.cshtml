@model IEnumerable<Shopping.Data.Entities.Sale>
@inject Shopping.Helpers.ITranslator Localizer
@{
    ViewData["Title"] = "Mis Pedidos";
}

<h1 class="mb-4">@Localizer["NavMyOrders"]</h1>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="fa-solid fa-box-open icon-lg text-accent"></i>
        <h4>Aún no tienes pedidos</h4>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Ver productos</a>
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead><tr><th>Id</th><th>Fecha</th><th>Líneas</th><th>Valor</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var sale in Model)
            {
                <tr>
                    <td>#@sale.Id</td>
                    <td>@sale.Date.ToString("dd/MM/yyyy")</td>
                    <td>@sale.Lines</td>
                    <td>@await Component.InvokeAsync("Currency", new { amount = sale.Value })</td>
                    <td><span class="badge bg-secondary">@Localizer[$"Status_{sale.OrderStatus}"]</span></td>
                    <td><a asp-action="Track" asp-route-id="@sale.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-truck"></i> Rastrear</a></td>
                </tr>
            }
        </tbody>
    </table>
}
